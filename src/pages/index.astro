---
import Base from '../layouts/Base.astro';
import Hero from '../components/hero/Hero';
---
<Base
  title="Take your first step towards financial freedom."
  description="Fynoptic helps people identify and avoid junk fees, dark patterns, and subscription traps—before they cost you money."
  canonical="/"
  ogTitle="Fynoptic"
  ogDescription="Understand the tactics. Avoid the traps."
>
  <!-- HERO -->
  <section class="hero" role="region" aria-labelledby="hero-heading">

    <div class="container hero-content">
      <!-- Hero island: headline, subhead, CTAs, partner strip, and the
           checkout ticket — a two-column grid (left content / right
           ticket) per spec §6.2, all built inside Hero.tsx now. The partner
           marquee used to be a sibling block here, spanning this whole
           container below the headline; it now lives inside Hero.tsx's
           left column (PartnerStrip.tsx) so it no longer spans full width.
           client:load (not client:visible): this content is always in the
           initial viewport, so there's no scroll distance for an
           IntersectionObserver to save — client:load hydrates it as soon as
           the bundle is ready instead of waiting on an observer callback
           for content that's already on screen. -->
      <Hero client:load />
    </div>
  </section>
  <!-- Section divider -->
  <hr class="section-divider" />
  <!-- ——— CENTERED STATEMENT ——— -->
  <!-- ——— CENTERED STATEMENT (non-bold) ——— -->
  <section class="statement" aria-labelledby="statement-title">
    <div class="container">
      <p id="statement-title" class="big-statement reveal-prism" data-reveal-words>
        Knowledge, confidence, and control,
        empowering you to make smarter financial choices
        with clarity and purpose.
      </p>
    </div>
  </section>
  <!-- ——— WHY USE FYNOPTIC ——— -->
  <section class="why-slab reveal-section" aria-labelledby="why-title">
    <div class="container">
      <h2 id="why-title" class="slab-title">Why use Fynoptic?</h2>

      <div class="slab-grid">
        <article class="slab-item reveal-card">
          <div class="disc">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3.5 9-7 10-3.5-1-7-5-7-10V6l7-3Z" stroke="currentColor" stroke-width="1.6"/></svg>
          </div>
          <h3>Courses</h3>
          <p>Explore 4 hands on courses designed to help you learn step by step.</p>
        </article>

        <article class="slab-item reveal-card">
          <div class="disc">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8Z" stroke="currentColor" stroke-width="1.6"/></svg>
          </div>
          <h3>Articles</h3>
          <p>Access a library of over 240 insightful articles on different topics.</p>
        </article>

        <article class="slab-item reveal-card">
          <div class="disc">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="7" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="2" fill="currentColor"/></svg>
          </div>
          <h3>Flashcards</h3>
          <p>Review and master 3,000+ vocabulary words with easy to use flashcards.</p>
        </article>

        <article class="slab-item reveal-card">
          <div class="disc">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h10a3 3 0 0 1 3 3v12H8a3 3 0 0 0-3 3V4Z" stroke="currentColor" stroke-width="1.6"/></svg>
          </div>
          <h3>Practice</h3>
          <p>Sharpen your skills with 10,000+ challenging practice questions.</p>
        </article>
      </div>
    </div>
  </section>


  <!-- Section divider -->
  <hr class="section-divider" />

  <!-- MOVEMENT CTA -->
  <!-- ——— FINAL CTA ——— -->
  <!-- ——— FINAL CTA (no box) ——— -->
  <section class="final-cta reveal-cta" aria-labelledby="cta-title">
    <div class="container">
      <h2 id="cta-title" class="cta-title">
        Ready to keep more<br><span>of your money?</span>
      </h2>

      <p class="cta-sub">
        Join thousands of users who trust Fynoptic for clear, fast, fee-saving decisions.
      </p>

      <a href="/courses" class="btn btn-cta" data-track="cta_click">
        Get started now
        <svg class="cta-arrow" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M7 17l10-10M11 7h6v6" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Other sections continue here: #course, #bot, #articles, etc. -->

  <!-- Modals -->
  <div id="fixit-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="fixit-title"></div>
  <div id="report-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="report-title"></div>
  <div id="writer-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="writer-title"></div>

  <!-- JSON-LD -->
  <script type="application/ld+json" is:inline>
    { "@context": "https://schema.org", "@type": "Course", "name": "Fynoptic Core Modules", "provider": { "@type": "Organization", "name": "Fynoptic" } }
  </script>

  <script>
    import { initReveal } from '../lib/reveal';

    // Split statement into spans with real spaces
    function splitRevealWords(): void {
      const el = document.querySelector<HTMLElement>('[data-reveal-words]');
      if (!el) return;
      const words = (el.textContent ?? '').trim().split(/\s+/);
      el.textContent = '';
      words.forEach((w, i) => {
        const span = document.createElement('span');
        span.textContent = w;
        span.style.setProperty('--i', String(i));
        el.appendChild(span);
        if (i < words.length - 1) el.appendChild(document.createTextNode(' '));
      });
    }

    // Stagger index for cards
    function staggerSlabItems(): void {
      document.querySelectorAll<HTMLElement>('.slab-item').forEach((n, i) => {
        n.style.setProperty('--i', String(i));
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.documentElement.classList.add('page-loaded');
      splitRevealWords();
      staggerSlabItems();
      initReveal();
    });
  </script>
</Base>

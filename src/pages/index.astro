---
import Base from '../layouts/Base.astro';
import Hero from '../components/hero/Hero';
import RackFocus from '../components/rack/RackFocus';
---
<Base
  title="Take your first step towards financial freedom."
  description="Fynoptic helps people identify and avoid junk fees, dark patterns, and subscription traps—before they cost you money."
  canonical="/"
  ogTitle="Fynoptic"
  ogDescription="Understand the tactics. Avoid the traps."
>
  <!-- HERO -->
  <section class="hero" role="region" aria-labelledby="hero-heading">

    <div class="container hero-content">
      <!-- Hero island: headline, subhead, CTAs, partner strip, and the
           checkout ticket — a two-column grid (left content / right
           ticket) per spec §6.2, all built inside Hero.tsx now. The partner
           marquee used to be a sibling block here, spanning this whole
           container below the headline; it now lives inside Hero.tsx's
           left column (PartnerStrip.tsx) so it no longer spans full width.
           client:load (not client:visible): this content is always in the
           initial viewport, so there's no scroll distance for an
           IntersectionObserver to save — client:load hydrates it as soon as
           the bundle is ready instead of waiting on an observer callback
           for content that's already on screen. -->
      <Hero client:load />
    </div>
  </section>

  <!-- RackFocus: courses/articles/flashcards/practice scroll-focus section.
       client:visible (not client:load): unlike the hero, this section sits
       below the fold on ordinary viewport heights (.hero's min-height is
       overridden to 0 in redesign.css, so its real height is just its
       content, but the rack section still normally starts below the first
       screenful) — deferring its JS fetch until it's actually needed is the
       right tradeoff for a component this size (framer-motion + the pinned
       scroll-math track). The concern about missing "the first scroll
       frames" doesn't actually apply: an IntersectionObserver's callback
       fires immediately with the current intersection state as soon as
       observe() is called, even if the element is already (partially) in
       view at load — it does not wait for a subsequent scroll event — so on
       a short viewport where the section is already visible at load,
       hydration begins immediately anyway. RackFocus also SSRs the static
       tab fallback (the same markup reduced-motion/narrow users get) as its
       pre-hydration state, so there is no broken or empty state either way
       while the bundle loads. -->
  <RackFocus client:visible />

  <!-- Other sections continue here: #course, #bot, #articles, etc. -->

  <!-- Modals -->
  <div id="fixit-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="fixit-title"></div>
  <div id="report-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="report-title"></div>
  <div id="writer-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="writer-title"></div>

  <!-- JSON-LD -->
  <script type="application/ld+json" is:inline>
    { "@context": "https://schema.org", "@type": "Course", "name": "Fynoptic Core Modules", "provider": { "@type": "Organization", "name": "Fynoptic" } }
  </script>

  <script>
    import { initReveal } from '../lib/reveal';

    document.addEventListener('DOMContentLoaded', () => {
      document.documentElement.classList.add('page-loaded');
      initReveal();
    });
  </script>
</Base>

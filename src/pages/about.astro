---
import Base from '../layouts/Base.astro';
import '../styles/about.css';
---
<Base
  title="About • Fynoptic"
  description="About Fynoptic — Meet the founders and our partners."
  canonical="/about"
  ogTitle="About • Fynoptic"
  ogDescription="Meet the founders and our partners."
>
  <section class="founders-slab" role="region" aria-labelledby="founders-title">
    <div class="container">
      <h1 id="founders-title" class="slab-title">Meet the Founders</h1>

      <div class="founders-grid">
        <article class="founder-card" tabindex="0">
          <div class="portrait" aria-hidden="true">
            <img src="/assets/img/arhan-barve.webp" alt="" />
            <span class="shine" aria-hidden="true"></span>
            <span class="ring" aria-hidden="true"></span>
          </div>
          <div class="founder-meta">
            <h3 class="founder-name">Arhan Barve</h3>
            <p class="founder-title">Co-Founder &amp; President</p>
          </div>
        </article>

        <article class="founder-card" tabindex="0">
          <div class="portrait" aria-hidden="true">
            <img src="/assets/img/ethan-baek.webp" alt="" />
            <span class="shine" aria-hidden="true"></span>
            <span class="ring" aria-hidden="true"></span>
          </div>
          <div class="founder-meta">
            <h3 class="founder-name">Ethan Baek</h3>
            <p class="founder-title">Co-Founder &amp; Vice President</p>
          </div>
        </article>

        <article class="founder-card" tabindex="0">
          <div class="portrait" aria-hidden="true">
            <img src="/assets/img/vishwa-rajan.webp" alt="" />
            <span class="shine" aria-hidden="true"></span>
            <span class="ring" aria-hidden="true"></span>
          </div>
          <div class="founder-meta">
            <h3 class="founder-name">Vishwa Rajan</h3>
            <p class="founder-title">Co-Founder &amp; Head of Outreach</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="partners-slab" role="region" aria-labelledby="partners-title">
    <div class="container">
      <h2 id="partners-title" class="slab-title">Our Partners</h2>

      <ul class="partners-grid" role="list" aria-label="Partner logos">
        <li class="partner-cell"><img src="/assets/img/emory.webp" alt="Emory University" /></li>
        <li class="partner-cell"><img src="/assets/img/invesco.webp" alt="Invesco" /></li>
        <li class="partner-cell"><img src="/assets/img/gcee-logo.webp" alt="Georgia Council on Economic Education" /></li>
        <li class="partner-cell"><img src="/assets/img/national-economic-challenge-logo.webp" alt="National Economic Challenge" /></li>
        <li class="partner-cell"><img src="/assets/img/national-personal-finance-challenge-logo.webp" alt="National Personal Finance Challenge" /></li>
      </ul>
    </div>
  </section>

  <div id="fixit-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="fixit-title"></div>
  <div id="report-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="report-title"></div>
  <div id="writer-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="writer-title"></div>
</Base>

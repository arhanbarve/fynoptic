---
import Base from '../layouts/Base.astro';
import { ARTICLE_META } from '../data/articles';
import { computeReadMins, deriveBlurb } from '../lib/article-summary';
import { ArticlesBrowser } from '../components/articles/ArticlesBrowser';

// Bodies are read at build time only. Nothing here reaches the browser except
// the rendered cards, so the index costs no article payload at runtime.
const bodies = import.meta.glob('../articles/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const cards = ARTICLE_META.map((a) => {
  const body = bodies[`../articles/${a.id}.html`];
  if (typeof body !== 'string') throw new Error(`missing article body for id: ${a.id}`);
  return { ...a, blurb: deriveBlurb(body), readMins: computeReadMins(body) };
});
---
<Base
  title="Articles & Guides — Fynoptic"
  description="Read Fynoptic articles & guides to spot and stop predatory fees, dark patterns, and subscription traps."
  canonical="/articles"
  ogTitle="Articles & Guides — Fynoptic"
  ogDescription="Know the playbook. Beat the traps."
>
  <!-- Hero -->
  <section class="articles-hero container">
    <h1>Articles & Guides</h1>
    <p>Clear, student-friendly explainers to help you spot junk fees, avoid dark patterns, and act with confidence.</p>

    <!-- Controls -->
    <div class="controls">
      <div class="controls-row">
        <div class="search-wrap" role="search" aria-label="Search articles">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" opacity=".8" d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79L19 21.5 21.5 19l-6-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
          <input id="search-input" type="search" placeholder="Search titles and summaries…" aria-describedby="search-hint" autocomplete="off" />
          <span id="search-hint" class="kbd">/</span>
        </div>

        <!--
          The tag filter and the newest/oldest sort that used to sit here are
          gone on purpose. Every article carried the same invented tag
          ("Guides") and a date synthesised from its array index, so the filter
          offered one real option and "newest" sorted by position in a file.
          The sorts below all run on real, derived data. See IMPLEMENTATION.md Q6.
        -->
        <div class="sort">
          <label for="sort-select" class="sr-only">Sort</label>
          <select id="sort-select" aria-label="Sort articles">
            <option value="featured">Featured order</option>
            <option value="az">Title A–Z</option>
            <option value="za">Title Z–A</option>
            <option value="short">Shortest read</option>
            <option value="long">Longest read</option>
          </select>
          <span class="result-count" id="result-count" aria-live="polite"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Grid -->
  <section class="container" aria-label="Article results">
    <div id="articles-grid" class="articles-grid">
      {cards.map((a) => (
        <a
          class="card article-card"
          href={`/articles/${a.id}`}
          data-title={a.title}
          data-blurb={a.blurb}
          data-read={String(a.readMins)}
        >
          <div class="art-media">
            <span class="art-badge">Guide</span>
          </div>
          <h3 class="art-title">{a.title}</h3>
          <div class="art-meta">{a.readMins} min read</div>
          <p class="art-blurb">{a.blurb}</p>
        </a>
      ))}
    </div>

    <div id="empty-state" class="card" hidden style="text-align:center;">
      <h3>No results</h3>
      <p class="art-meta">Try a different search.</p>
      <div style="margin-top:.5rem;">
        <button id="clear-filters" class="btn btn-ghost">Clear search</button>
      </div>
    </div>

    <div style="text-align:center; margin-top:1rem;">
      <button id="load-more" class="btn btn-ghost" aria-label="Load more articles">Load more</button>
    </div>
  </section>

  <!--
    Renders nothing (see ArticlesBrowser.tsx) — it wires up the search
    input, sort select, result count, empty state and load-more button
    above, all of which stay exactly as Astro rendered them, and only ever
    toggles `hidden` / reorders the 244 cards already in #articles-grid.
    client:load so the grid is paged down to 12 cards immediately, not
    deferred until scrolled into view.
  -->
  <ArticlesBrowser client:load />

  <!-- Back to top -->
  <button class="btn btn-primary float-top" id="float-top" aria-label="Back to top">↑</button>

  <!-- JSON-LD (keep inline for SEO) -->
  <script type="application/ld+json" is:inline>
  {
    "@context":"https://schema.org",
    "@type":"CollectionPage",
    "name":"Fynoptic Articles & Guides",
    "isPartOf":{"@type":"WebSite","name":"Fynoptic"},
    "about":["Consumer protection","Fees","Subscriptions","BNPL","Disputes","Privacy"]
  }
  </script>

  <style is:global>
    /* The cards are links now — each one opens its own /articles/<id> page
       instead of a client-side overlay with no shareable URL. The shared .card
       skin assumes a block container, so undo the anchor defaults. */
    .articles-grid .article-card {
      display: block;
      text-decoration: none;
      color: inherit;
    }
    .articles-grid .article-card:focus-visible {
      outline: 2px solid var(--db-optic, currentColor);
      outline-offset: 3px;
    }
  </style>

  <script>
    import { initBackToTop } from '../lib/back-to-top';

    document.addEventListener('DOMContentLoaded', () => {
      initBackToTop();
    });
  </script>
</Base>

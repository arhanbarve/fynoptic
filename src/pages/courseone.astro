---
import Base from '../layouts/Base.astro';
import { CourseOne } from '../components/course/CourseOne';
---
<Base
  title="Fynoptic — Course 1: Dark Patterns—Spot Them, Stop Them"
  description="Course 1 — Dark Patterns—Spot Them, Stop Them. Learn to identify dark patterns and act fast with proof. Certification included."
  canonical="/courseone"
  ogTitle="Course 1 — Dark Patterns—Spot Them, Stop Them"
  ogDescription="Know the playbook. Beat the traps."
>
  <!--
    Page-specific styles, ported from courseone.html's inline <style> block
    plus a handful of new utility classes (.mt-1/.mt-05/.badge-row/
    .drills-textarea/.cert-*) that replace what were ~24 inline style="..."
    attributes in the original markup.

    is:global, not scoped, for two reasons:
      1. Most of this page's content (quiz cards, markdown articles, the
         TOC, locked-section overlays, drawers) is rendered client-side by
         the <CourseOne client:load /> island (src/components/course/CourseOne.tsx).
         Astro's scoped CSS only tags elements present in this component's
         own server-rendered output with the scoping attribute — DOM nodes
         mounted later by the React island never get it, so scoped rules
         would silently fail to match most of the page.
      2. The @media print rule and the body.hc/body.dyslexia rules target
         .header/.footer/.nav/.toast-container/<body> — all rendered by
         Nav.tsx/Footer.tsx/Toaster.tsx/Base.astro, outside this component's
         own subtree, so scoping couldn't reach them either way.
    (Same is:global choice src/pages/courses.astro already made for its
    own page-specific style block.)
  -->
  <style is:global>
    @media print {
      body { background: #fff !important; color: #000 !important; }
      .header, .footer, .a11y-bar, .stepper-wrap, .toast-container, .nav { display: none !important; }
      .certificate-sheet { display: block !important; page-break-inside: avoid; }
    }

    .course-shell { padding: 2rem 0 3rem; background: var(--grad-hero); position: relative; overflow: hidden; }
    /* width/height are not optional here. `inset: 0` on an absolutely
       positioned REPLACED element with `width: auto` is over-constrained:
       the box takes the image's intrinsic size and `right`/`bottom` are
       ignored. texture-noise.svg is 700x700, so this painted a hard-edged
       700px square of noise in the band's top-left corner — visible as a
       rectangle with a seam down the middle of the hero on every viewport
       wider than 700px — instead of tiling the band. */
    .course-shell .bg-noise {
      position: absolute; inset: 0; opacity: .06;
      width: 100%; height: 100%; object-fit: cover;
    }

    /* Dead CSS, ported as-is: no .a11y-bar/.stepper-wrap element exists in
       this page's markup (checked both this worktree's and auth-overhaul's
       courseone.html) — course-one.js's stepper/a11y bindings are
       defensive no-ops for the same reason. Not fixed here; out of scope
       for this port. */
    .a11y-bar { position: sticky; top: 64px; z-index: 50; background: rgba(17,26,46,.7); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,.08); border-radius: 12px; margin: 0 auto 1rem; max-width: var(--container-max); padding: .5rem .75rem; }
    .a11y-bar form { display: flex; gap: .75rem; flex-wrap: wrap; align-items: center; justify-content: flex-end; }
    .a11y-bar label { font-size: .9rem; color: var(--text-300); display: flex; gap: .5rem; align-items: center; }
    .stepper-wrap { position: sticky; top: 112px; z-index: 40; background: rgba(11,18,32,.75); backdrop-filter: blur(8px); border-top: 1px solid rgba(255,255,255,.06); border-bottom: 1px solid rgba(255,255,255,.06); }

    .section { padding: 3rem 0; }
    .subtle { color: var(--text-300); }
    .block { display: block; }
    .inline-list { display: flex; gap: .5rem; flex-wrap: wrap; }
    .badge-row { align-items: center; }
    .kbd { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.12); padding: .2rem .4rem; border-radius: 6px; }
    .gate { margin-top: 1rem; display: flex; gap: .5rem; flex-wrap: wrap; }
    .locknote { color: var(--text-300); font-size: .95rem; }
    .video-wrap { border: 1px solid rgba(255,255,255,.08); border-radius: 16px; overflow: hidden; background: rgba(255,255,255,.04); box-shadow: var(--shadow-lg); }
    .content-card { background: rgba(17,26,46,.6); border: 1px solid rgba(255,255,255,.08); border-radius: 16px; padding: 1.25rem; box-shadow: var(--shadow-lg); }
    .md { line-height: 1.75; }
    .md h2, .md h3 { font-family: var(--font-head); margin-top: 1.25rem; }
    .md ul { list-style: disc; padding-left: 1.25rem; }
    .md li { margin: .35rem 0; }
    .transcript details { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 12px; padding: .75rem 1rem; }
    .quiz-card { background: rgba(17,26,46,.6); border: 1px solid rgba(255,255,255,.08); border-radius: 16px; padding: 1rem; box-shadow: var(--shadow-lg); }
    .q-item { padding: 1rem; border-radius: 12px; border: 1px solid rgba(255,255,255,.06); background: rgba(255,255,255,.03); margin-bottom: .75rem; }
    .q-item.correct { border-color: rgba(34,209,178,.5); box-shadow: 0 0 0 2px rgba(34,209,178,.15) inset; }
    .q-item.incorrect { border-color: rgba(240,68,56,.5); box-shadow: 0 0 0 2px rgba(240,68,56,.12) inset; }
    .q-title { font-weight: 600; margin-bottom: .5rem; }
    .q-options { display: grid; gap: .5rem; }
    .q-options label { display: flex; gap: .5rem; align-items: flex-start; cursor: pointer; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); padding: .6rem .7rem; border-radius: 10px; }
    .result { margin-top: .5rem; font-size: .95rem; color: var(--text-300); }
    .drawer { border-top: 1px dashed rgba(255,255,255,.12); margin-top: .6rem; padding-top: .6rem; }
    .id-grid { display: grid; gap: .75rem; }
    /* The form is a stack of full-width rows; the two-up pairing is `.row-2`'s
       job, one level down. Without `grid-template-columns` pinned the form
       resolved to two implicit tracks (183px + 226px against a 316px card on
       a 390px phone) and pushed its inputs ~105px off the right of the
       screen. */
    .audit-form { display: grid; grid-auto-flow: row; grid-template-columns: minmax(0, 1fr); gap: .75rem; }
    /* `minmax(220px, 1fr)` is a hard 220px floor, and `auto-fit` cannot
       drop below it — so inside the Risk Audit card on a 390px phone
       (~300px of content width after the page gutter and the card's own
       padding) the track stayed 220px wide and its <input> pushed 105px
       past the right edge of the screen. `min(220px, 100%)` keeps the
       two-up layout wherever 220px actually fits and lets the track
       collapse to the container below that. */
    .row-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: .75rem; }
    .row-2 :is(input, select, textarea) { min-width: 0; max-width: 100%; }
    .row-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px,1fr)); gap: .75rem; }
    .audit-output { white-space: pre-wrap; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); border-radius: 12px; padding: .75rem; }
    .certificate { display: none; }
    .certificate.ready { display: block; }
    .certificate-sheet { display: none; background: #fff; color: #0b1220; border-radius: 12px; padding: 1.25in; }
    .badge-svg { width: 120px; height: 120px; }

    /* Utility classes replacing this page's inline style="..." attributes */
    .mt-1 { margin-top: 1rem; }
    .mt-05 { margin-top: .5rem; }
    .drills-textarea { width: 100%; margin-top: .5rem; }
    .cert-header { display: flex; align-items: center; gap: 16px; margin-bottom: 24px; }
    .cert-logo { width: 56px; height: 56px; }
    .cert-title-block h1 { margin: 0; font-family: 'Space Grotesk', sans-serif; }
    .cert-org { color: #111; font-family: Inter, sans-serif; }
    .cert-hr { border: none; border-top: 2px solid #111; margin: 16px 0 24px; }
    .cert-body-text { font-size: 18px; font-family: Inter, sans-serif; }
    .cert-badge-row { display: flex; align-items: center; gap: 16px; margin-top: 24px; }
    .cert-badge-meta { font-family: Inter, sans-serif; }

    /* Accessibility toggles (see file header re: no matching bar markup) */
    body.hc { --brand-900: #0b1220; --text-300: #dbe4ff; }
    body.dyslexia * { letter-spacing: .02em; word-spacing: .02em; }
  </style>

  <section class="course-shell" aria-labelledby="title">
    <img class="bg-noise" src="/assets/texture-noise.svg" alt="" aria-hidden="true" />
    <div class="container">
      <h1 id="title">Dark Patterns: Spot Them, Stop Them</h1>
      <p class="subtle">
        Audience: General consumers (teens → adults) · Duration: ~80 minutes self-paced · Goal: Teach learners to recognize dark patterns quickly and take the fastest effective counter-action with clean documentation.
      </p>
      <ul class="inline-list subtle" aria-label="Completion criteria">
        <li class="chip">Post-Assessment ≥ 80%</li>
        <li class="chip">Submit Risk Audit</li>
        <li class="chip">Badge: “Dark Pattern Spotter”</li>
      </ul>
    </div>
  </section>

  <CourseOne client:load />
</Base>

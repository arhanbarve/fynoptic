---
import Base from '../layouts/Base.astro';
import { Bot } from '../components/bot/Bot';
---
<Base
  title="Know the playbook. Beat the traps."
  description="Fynoptic helps consumers spot and stop predatory fees, dark patterns, and subscription traps—before they hit your wallet."
  canonical="/bot"
  ogTitle="Fynoptic"
  ogDescription="Know the playbook. Beat the traps."
>
  <div class="chat-shell">
    <!-- Animated ambient background -->
    <div class="chat-bg">
      <img src="/assets/texture-noise.svg" alt="" aria-hidden="true" />
      <div class="orb orb1"></div>
      <div class="orb orb2"></div>
    </div>

    <!-- Chat UI -->
    <section class="chat-area container">
      <div class="chat-title">
        <h1>Fix-it Bot</h1>
        <p class="chat-subtext">Tell me what’s happening and I’ll guide you.</p>
      </div>

      <!-- client:load (not client:visible): this widget is the entire point
           of the page and sits above the fold on every viewport, so there's
           no scroll distance to defer hydration across. -->
      <Bot client:load />
    </section>
  </div>
</Base>

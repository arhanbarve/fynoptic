---
import Base from '../layouts/Base.astro';
import { Profile } from '../components/profile/Profile';
---
<Base
  title="Your Profile • Fynoptic"
  description="Manage your Fynoptic account and progress."
  canonical="/profile"
  ogTitle="Your Profile • Fynoptic"
  ogDescription="Manage your Fynoptic account and progress."
>
  <!-- client:load (not client:visible): this is the entire content of the
       page — nothing above the fold to defer hydration across — and the
       signed-out redirect must fire as soon as auth resolves, not once the
       component happens to scroll into view. -->
  <Profile client:load />
</Base>

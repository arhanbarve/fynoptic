---
import Base from '../layouts/Base.astro';
---
<Base
  title="Know the playbook. Beat the traps."
  description="Fynoptic helps consumers spot and stop predatory fees, dark patterns, and subscription traps—before they hit your wallet."
  canonical="/courses"
  ogTitle="Fynoptic"
  ogDescription="Know the playbook. Beat the traps."
>
  <!-- Added: minimal styles for scroll behavior, course descriptions, and Back-to-Top -->
  <style is:global>
    /* Scrollable description for detailed content without changing layout */
    .course-desc {
      max-height: 180px;
      overflow: auto;
      padding: 0.5rem 0;
      border-top: 1px solid rgba(255,255,255,0.08);
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .course-desc p { margin: 0 0 .5rem; }
    .course-desc ul { margin: 0; padding-left: 1.2rem; }
    .course-desc li { margin: .25rem 0; }

    /* Optional bullet styling inside headers for the “soon” cards */
    .course-card__head .course-points { margin: .5rem 0 0 1rem; }

    /* Back-to-Top button */
    .back-to-top {
      position: fixed;
      right: 1rem;
      bottom: 1rem;
      display: none;
      z-index: 1000;
      border: none;
      border-radius: 999px;
      padding: .6rem .9rem;
      background: linear-gradient(135deg, #0B1220, #18304a);
      color: #fff;
      box-shadow: 0 10px 24px rgba(0,0,0,.28);
      cursor: pointer;
      font-weight: 600;
    }
    .back-to-top.show { display: inline-flex; }
    .back-to-top:focus { outline: 2px solid #8bd; outline-offset: 2px; }
  </style>

  <!-- Moved: How certification works (now at top, as requested) -->


  <!-- Hero -->
  <section class="courses-hero" aria-labelledby="courses-hero-title">
    <div class="courses-hero-bg" aria-hidden="true">
      <img src="/assets/texture-noise.svg" alt="" role="img" aria-hidden="true" />
      <div class="c-orb c-orb--blue"></div>
      <div class="c-orb c-orb--teal"></div>
      <div class="c-ring c-ring--1"></div>
      <div class="c-ring c-ring--2"></div>
    </div>

    <div class="container">
      <h1 id="courses-hero-title">Courses & Certifications</h1>
      <p class="courses-hero-sub">Clear, practical, student friendly modules—built to certify real skills. Finish the steps, pass the assessment, earn your badge.</p>
      <div class="courses-hero-cta">
        <a class="btn btn-primary" href="#catalog" data-track="cta_click">Browse Catalog</a>
        <a class="btn btn-ghost" href="/articles">Study with Articles</a>
      </div>

      <div class="courses-hero-metrics">
        <div class="c-metric">
          <div class="c-metric__num">8</div>
          <div class="c-metric__label">Courses Available</div>
        </div>
        <div class="c-metric">
          <div class="c-metric__num">80<span class="c-unit">min</span></div>
          <div class="c-metric__label">Flagship Duration</div>
        </div>
        <div class="c-metric">
          <div class="c-metric__num">✔︎</div>
          <div class="c-metric__label">Certificate on Completion</div>
        </div>
      </div>
    </div>

  </section>
  <section class="how-cert container" aria-labelledby="how-cert-title">
    <h2 id="how-cert-title" class="fade-up">How certification works</h2>
    <div class="how-grid">
      <div class="how card fade-up">
        <div class="how__icon" aria-hidden="true">1</div>
        <h3>Learn</h3>
        <p>Short videos + focused reading. Keyboard-friendly, transcripts included.</p>
      </div>
      <div class="how card fade-up">
        <div class="how__icon" aria-hidden="true">2</div>
        <h3>Check</h3>
        <p>Pass the assessment (≥ 80%). Immediate feedback and review links.</p>
      </div>
      <div class="how card fade-up">
        <div class="how__icon" aria-hidden="true">3</div>
        <h3>Prove</h3>
        <p>Generate a one-page Risk Audit. Download your badge and certificate.</p>
      </div>
    </div>
  </section>

  <!-- Catalog -->
  <section id="catalog" class="courses-catalog container" aria-labelledby="catalog-title">
    <h2 id="catalog-title" class="fade-up">Available Courses</h2>
    <p class="catalog-note fade-up">Progress saves to your device. Certification requires completing all sections and meeting assessment thresholds.</p>

    <div class="courses-grid">
      <!-- Course 1 (live) -->
      <article class="course-card fade-up" data-course-id="dark-patterns">
        <header class="course-card__head">
          <span class="badge badge--grad" aria-label="Certified course">Certified</span>
          <h3 class="course-card__title">Dark Patterns: Spot Them, Stop Them</h3>
          <p class="course-card__meta">Audience: teens → adults · Duration: ~80 minutes · No prereqs</p>
        </header>

        <ul class="course-criteria">
          <li>Post-Assessment ≥ 80% (12 scored items)</li>
          <li>Submit a one-page “Risk Audit”</li>
          <li>Badge: “Dark Pattern Spotter”</li>
        </ul>

        <!-- Added: Detailed, scrollable description -->
        <div class="course-desc" aria-label="Course description" tabindex="0">

          <ul>
            <li>Identify 10+ common dark patterns.</li>
            <li>Hands-on spotting drills</li>
            <li>Build a reusable “Risk Audit”</li>
          </ul>
        </div>

        <!-- Stepper (pre-quiz → modules → post-quiz) -->
        <ol class="course-stepper" aria-label="Course sections">
          <li class="step is-unlocked">
            <span class="dot" aria-hidden="true"></span><span>Pre-Quiz</span>
          </li>
          <li class="step is-locked">
            <span class="dot" aria-hidden="true"></span><span>Module 1</span>
          </li>
          <li class="step is-locked">
            <span class="dot" aria-hidden="true"></span><span>Module 2</span>
          </li>
          <li class="step is-locked">
            <span class="dot" aria-hidden="true"></span><span>Module 3</span>
          </li>
          <li class="step is-locked">
            <span class="dot" aria-hidden="true"></span><span>Module 4</span>
          </li>
          <li class="step is-locked">
            <span class="dot" aria-hidden="true"></span><span>Post-Quiz</span>
          </li>
        </ol>

        <!-- Progress -->
        <div class="course-progress" role="img" aria-label="Progress 0 percent">
          <div class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <span class="progress-fill" style="--p: 0%"></span>
          </div>
          <div class="progress-meta">
            <span class="progress-count"><strong>0</strong>/6 sections</span>
            <span class="progress-status">Not Started</span>
          </div>
        </div>

        <footer class="course-card__actions">
          <a class="btn btn-primary" href="/courseone" data-track="cta_click" aria-label="Open course Dark Patterns: Spot Them, Stop Them">Open Course</a>
        </footer>
      </article>

      <!-- Course 2 (placeholder) -->
      <article class="course-card course-card--soon fade-up" aria-describedby="soon-2">
        <header class="course-card__head">
          <span class="badge">Certified</span>
          <h3 class="course-card__title">Subscriptions & Memberships — Defense in 4 Steps</h3>

        </header>
        <div class="soon-mask" aria-hidden="true">
          <span>Available after completing course 1</span>
        </div>
        <footer class="course-card__actions">
          <a class="btn btn-ghost" aria-disabled="true">Preview Unavailable</a>
        </footer>
      </article>

      <!-- Course 3 (placeholder) -->
      <article class="course-card course-card--soon fade-up" aria-describedby="soon-3">
        <header class="course-card__head">
          <span class="badge">Certified</span>
          <h3 class="course-card__title"> Disputes & Refunds — From “Stuck” to Credited</h3>

        </header>
        <div class="soon-mask" aria-hidden="true">
          <span>Available after completing course 2</span>
        </div>
        <footer class="course-card__actions">
          <a class="btn btn-ghost" aria-disabled="true">Preview Unavailable</a>
        </footer>
      </article>

      <!-- Course 4 (placeholder) -->
      <article class="course-card course-card--soon fade-up" aria-describedby="soon-4">
        <header class="course-card__head">
          <span class="badge">Certified</span>
          <h3 class="course-card__title">Money Skills for Students — Campus & App Pitfalls</h3>

        </header>
        <div class="soon-mask" aria-hidden="true">
          <span>Available after completing course 3</span>
        </div>
        <footer class="course-card__actions">
          <a class="btn btn-ghost" aria-disabled="true">Preview Unavailable</a>
        </footer>
      </article>
    </div>
    <div class="courses-grid courses-grid--bottom">
      <article class="course-card course-card--soon fade-up" aria-describedby="soon-4">
        <header class="course-card__head">
          <span class="badge">Certified</span>
          <h3 class="course-card__title">AI Scams & Deepfakes — Spot the Synthetic Tricks Fast</h3>
        </header>
        <div class="soon-mask" aria-hidden="true">
          <span>Available after completing course 4</span>
        </div>
        <footer class="course-card__actions">
          <a class="btn btn-ghost" aria-disabled="true">Preview Unavailable</a>
        </footer>
      </article>
      <article class="course-card course-card--soon fade-up" aria-describedby="soon-4">
        <header class="course-card__head">
          <span class="badge">Certified</span>
          <h3 class="course-card__title">Privacy Permissions — Take Back Control of Your Data</h3>

        </header>
        <div class="soon-mask" aria-hidden="true">
          <span>Available after completing course 5</span>
        </div>
        <footer class="course-card__actions">
          <a class="btn btn-ghost" aria-disabled="true">Preview Unavailable</a>
        </footer>
      </article>
      <article class="course-card course-card--soon fade-up" aria-describedby="soon-4">
        <header class="course-card__head">
          <span class="badge">Certified</span>
          <h3 class="course-card__title">Ad Transparency — Decode Ads, Influencers, and Algorithms</h3>

        </header>
        <div class="soon-mask" aria-hidden="true">
          <span>Available after completing course 6</span>
        </div>

        <footer class="course-card__actions">
          <a class="btn btn-ghost" aria-disabled="true">Preview Unavailable</a>
        </footer>
        <p>
          <br>
          <br>

          <br>

          <br>

          <br>

          <br>

          <br>
          <br>
          <br>
          <br>
          <br>
          <br>
          <br>
          <br>
          <br>
          <br>
          <br>

        </p>
      </article>
      <article class="course-card course-card--soon fade-up" aria-describedby="soon-4">
        <header class="course-card__head">
          <span class="badge">Certified</span>
          <h3 class="course-card__title">Chargeback Playbook — How to Win When Merchants Push Back</h3>

        </header>
        <div class="soon-mask" aria-hidden="true">
          <span>Available after completing course 7</span>
        </div>
        <footer class="course-card__actions">
          <a class="btn btn-ghost" aria-disabled="true">Preview Unavailable</a>
        </footer>
      </article>
    </div>
    <!-- (Removed from here) How certification works was moved above -->
  </section>

  <!-- Back to Top button -->
  <button id="back-to-top" class="back-to-top" aria-label="Back to top">↑ Top</button>

  <!-- JSON-LD -->
  <script type="application/ld+json" is:inline>
    {
      "@context":"https://schema.org",
      "@type":"ItemList",
      "name":"Fynoptic Courses",
      "itemListElement":[
        {
          "@type":"Course",
          "position":1,
          "name":"Dark Patterns—Spot Them, Stop Them",
          "description":"Identify common dark patterns and respond with fast, effective counter-moves and documentation.",
          "provider":{"@type":"Organization","name":"Fynoptic","url":"https://Fynoptic.org"}
        }
      ]
    }
  </script>

  <!-- Back-to-Top visibility & action (deduped via ../lib/back-to-top) -->
  <script>
    import { initBackToTop } from '../lib/back-to-top';

    document.addEventListener('DOMContentLoaded', () => {
      initBackToTop();
    });
  </script>
</Base>

---
// Shared <head> + <body> shell. Required title/description/canonical fixes
// D15 — flashcard.html, practice.html, profile.html shipped none of the
// three in the legacy site, and courses.html/bot.html shared an identical
// <title>. A page cannot omit them here without a type error.
//
// Fonts are self-hosted via @fontsource (fixes D12 — the legacy site loaded
// three families render-blocking from a third-party CDN on every page).
//
// canonical is extensionless to match the hrefs Nav/Footer emit — see
// IMPLEMENTATION.md §0.1 for why: pairing extensionless links with a .html
// canonical is self-contradictory for search engines, confirmed live that
// GitHub Pages serves both forms, so this is a consistency fix, not a new
// SEO judgment call.
import '@fontsource-variable/inter';
import '@fontsource/spectral/600.css';
import '../styles/legacy.css';
import '../styles/redesign.css';
import '../styles/globals.css';
import SiteBg from '../components/SiteBg.astro';
import { Nav } from '../components/shell/Nav';
import { Footer } from '../components/shell/Footer';
import { Toaster } from '../components/shell/Toaster';
import { AuthDialog } from '../components/auth/AuthDialog';

interface Props {
  title: string;
  description: string;
  /** Extensionless, site-relative, e.g. "/about" or "/" for the homepage. */
  canonical: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonical,
  ogTitle = title,
  ogDescription = description,
  ogImage = 'https://fynoptic.org/assets/img/fynopticlogo.png',
} = Astro.props;

const canonicalUrl = new URL(canonical, 'https://fynoptic.org').toString();
---

<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  <meta charset="UTF-8" />
  <script is:inline>
    // Pre-paint theme: sets data-theme on <html> synchronously, before any
    // stylesheet is parsed, so a stored preference never flashes the wrong
    // theme on load/navigation. Mirrors getTheme()'s key/default in
    // ../lib/storage.ts — keep the two in sync if that logic ever changes.
    // <body> can't be touched this early (it doesn't exist yet); Nav.tsx's
    // mount effect (Phase 5) re-applies the same value to both <html> and
    // <body> once React hydrates, using the same storage key/default, so it
    // recomputes the same value and never flips it.
    (function () {
      try {
        var theme = localStorage.getItem('fynoptic-theme');
        document.documentElement.setAttribute('data-theme', theme === 'light' ? 'light' : 'dark');
      } catch (e) {}
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0B1220" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Icons — identical on every page -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/assets/icons/favicon-96x96.png" type="image/png" sizes="96x96" />
  <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <title>{title}</title>
</head>
<body data-theme="dark">
  <a href="#main" class="skip-link">Skip to content</a>
  <SiteBg />
  <Nav client:load />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Toaster client:load />
  <Footer />
  <AuthDialog client:load />

  <script>
    // Phase 5: initNav, initModals's login/signup/reset wiring, initAuthUI
    // and initToasts are retired — Nav/AuthDialog/Toaster above cover all of
    // it. Two imperative calls remain:
    //   - applyA11y(): still DOM-only (body.hc/body.dyslexia), no React
    //     consumer of prefsStore exists yet.
    //   - initModals(): NOT retired, despite Phase 5's plan text. It's still
    //     the only thing giving Escape/backdrop-click to every modal that
    //     hasn't been converted yet — practice.astro's #end-session-modal
    //     (practice.spec.ts pins Escape hiding it), course-one's modals, and
    //     the flashcard/practice/index/about fixit/report/writer stubs. See
    //     the comment atop lib/modal.ts for how it now steps aside for
    //     Radix-owned (login/signup/reset) modals instead of fighting them.
    //   - initAuthWatcher(): boots ensureAuthReady() + the onAuthStateChanged
    //     subscription authStore needs. Nothing else calls this — Nav and
    //     AuthDialog both read authStore via useAuth()/its store directly,
    //     they don't set it up.
    // initTheme() is gone: the pre-paint script in <head> plus useTheme()
    // (via Nav's theme button) now cover every case that used to need it.
    import { initModals } from '../lib/modal';
    import { initAuthWatcher } from '../lib/auth';
    import { applyA11y } from '../lib/a11y';

    document.addEventListener('DOMContentLoaded', () => {
      applyA11y();
      initModals();
      initAuthWatcher();
    });
  </script>
</body>
</html>

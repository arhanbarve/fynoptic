{
  "name": "fynoptic",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/sync-public.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-public.mjs",
    "build": "astro check && astro build",
    "prepreview": "node scripts/sync-public.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --ext .js,.ts,.astro",
    "format": "prettier --write \"**/*.{ts,astro,css,md,json}\"",
    "test:unit": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:unit:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:e2e": "playwright test",
    "test:visual:capture": "node scripts/visual-diff.mjs --capture-baseline",
    "test:visual:diff": "node scripts/visual-diff.mjs --diff",
    "test:all": "npm run test:unit && npm run test:e2e && npm run test:visual:diff"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "framer-motion": "^13.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9",
    "@axe-core/playwright": "^4.12.1",
    "@fontsource-variable/inter": "^5",
    "@fontsource-variable/sora": "^5",
    "@fontsource/spectral": "^5",
    "@playwright/test": "^1",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9",
    "eslint-plugin-astro": "^1",
    "firebase-tools": "^15",
    "jsdom": "^30",
    "pixelmatch": "^7",
    "pngjs": "^7",
    "prettier": "^3",
    "prettier-plugin-astro": "^0",
    "typescript": "^5",
    "vitest": "^4",
    "zod": "^3"
  }
}
